{
    "name": "madesimple/slim-auth",
    "description": "Authentication and authorisation middleware for Slim framework",
    "type": "library",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.0",
        "psr/log": "^3.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "firebase/php-jwt": "^7.0",
        "phpunit/phpunit": "^12",
        "psr/container": "^2.0",
        "slim/psr7": "^1.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Scopes",
            "email": "peter.scopes@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Slim\\Middleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MadeSimple\\Slim\\Middleware\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "ext-openssl": "Required to use keys/certificates with firebase/php-jwt",
        "firebase/php-jwt": "Required to use FirebaseJwtAuthentication (^7.0)"
    },
    "config": {
        "audit": {
            "abandoned": "fail"
        },
        "sort-packages": true
    }
}
