<?xml version="1.0"?>
<ruleset name="MadeSimple">
    <description>The MadeSimple standard for PHP code</description>

    <!--
    Limit checks to just `.php` files, report as a summary, use colours, and include error code
    -->
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="75"/>
    <arg name="report" value="summary"/>
    <arg value="ns"/>

    <!--
    Explicitly state which files to be included
    -->
    <file>src</file>
    <file>tests</file>

    <!--
    Define the rules that the code must adhere to be compliant
    -->
    <rule ref="PSR1"/>
    <rule ref="PSR12"/>
</ruleset>
